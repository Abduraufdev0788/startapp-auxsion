# ==============================================================================
# AUCTIONHUB ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and fill in real values for your environment.
# Never commit actual secret keys or credentials to version control.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
APP_NAME=AuctionHub
APP_VERSION=1.0.0
TIMEZONE=Asia/Tashkent

# URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# PostgreSQL Database
POSTGRES_USER=auctionhub
POSTGRES_PASSWORD=auctionhub_dev_secret
POSTGRES_DB=auctionhub_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://auctionhub:auctionhub_dev_secret@localhost:5432/auctionhub_db

# Redis & Celery
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Security & JWT Tokens
JWT_SECRET_KEY=change-this-in-production-to-a-secure-random-64-character-string
JWT_REFRESH_SECRET_KEY=change-this-refresh-secret-to-a-secure-random-64-character-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Payment Gateway (Uzbekistan: Click / Payme / Sandbox Provider)
PAYMENT_PROVIDER=sandbox
PAYMENT_MERCHANT_ID=sandbox_merchant_id
PAYMENT_SECRET_KEY=sandbox_secret_key
PAYMENT_WEBHOOK_SECRET=sandbox_webhook_signing_secret
PAYMENT_CURRENCY=UZS

# File Storage (S3 / MinIO / Local)
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=/app/media_uploads
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=auctionhub-media
S3_REGION=us-east-1

# SMTP Email Settings
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@auctionhub.uz
SMTP_FROM_NAME=AuctionHub

# SMS Gateway (Uzbekistan: Eskiz / PlayMobile)
SMS_PROVIDER=sandbox
SMS_API_URL=
SMS_EMAIL=
SMS_PASSWORD=

# Platform Auction Business Rules Defaults
MIN_AUCTION_DURATION_HOURS=1
MAX_AUCTION_DURATION_DAYS=30
DEFAULT_BID_EXTENSION_MINUTES=5
BID_EXTENSION_THRESHOLD_MINUTES=2
DEFAULT_WINNER_PAYMENT_DEADLINE_DAYS=3

